# Nooit echte secrets naar GitHub uploaden.
ELEVENLABS_API_KEY=sk_vul_hier_in
ELEVENLABS_AGENT_ID=agent_vul_hier_in
ELEVENLABS_OUTBOUND_AGENT_ID=agent_outbound_vul_hier_in
ELEVENLABS_PHONE_NUMBER_ID=phnum_vul_hier_in
TWILIO_AUTH_TOKEN=vul_hier_in
PUBLIC_BASE_URL=https://my-call-agent.onrender.com
ELEVENLABS_WEBHOOK_SECRET=vul_hier_het_hmac_secret_in
RESEND_API_KEY=re_vul_hier_in
EMAIL_FROM=Fleur <onboarding@resend.dev>
EMAIL_TO=jouw-eigen-email@example.com

# Beveiligde outbound-opdrachten
OUTBOUND_ENABLED=false
OUTBOUND_USERNAME=brian
OUTBOUND_COMMAND_SECRET=gebruik_een_lange_willekeurige_waarde
OUTBOUND_MAX_CALLS_PER_HOUR=5
# Alleen deze contacten kunnen worden gebeld. Nummers moeten E.164-formaat gebruiken.
OUTBOUND_CONTACTS_JSON={"joanne":{"name":"Joanne","number":"+31612345678"}}

# Alleen voor lokale tests zonder echte Twilio-request:
# SKIP_TWILIO_SIGNATURE_VALIDATION=true
PORT=10000
